# Worker secret. Empty means diagnosis and ask stay unavailable.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini.
VISION_MODEL=
# Optional. Defaults to https://api.openai.com/v1.
VISION_API_BASE_URL=
# Worker secret. Empty means Escuchar uses the phone voice.
ELEVENLABS_API_KEY=
# ElevenLabs voice id. Required with the key. Do not invent one.
ELEVENLABS_VOICE_ID=
# Plain Worker var. The deployed value lives in wrangler.jsonc. Not a secret.
BLAXEL_ASK_URL=
# Worker secret, set in the Cloudflare dashboard. Not committed.
BLAXEL_API_KEY=
