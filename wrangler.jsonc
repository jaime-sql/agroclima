{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agroclima",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "agroclima"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_CACHE",
      "bucket_name": "agroclima-audio"
    }
  ],
  "vars": {
    "BLAXEL_ASK_URL": "https://run.blaxel.ai/hackatonhf2025/agents/agroclima-ask"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
